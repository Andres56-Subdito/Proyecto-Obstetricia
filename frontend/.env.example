# Copia este archivo como ".env.local" y reemplaza los valores con los de tu proyecto de Firebase.
# Consola de Firebase > Configuración del proyecto > General > Tus apps > Configuración del SDK (app Web).
# ".env.local" NO se sube a GitHub (está ignorado por .gitignore).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=